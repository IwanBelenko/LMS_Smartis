HTTP_PORT=80
HTTPS_PORT=443
APP_SITE_ADDRESS=https://lms.company.ru
SCORM_SITE_ADDRESS=https://scorm.company.ru

DJANGO_SECRET_KEY=replace-with-at-least-50-random-characters
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=lms.company.ru,scorm.company.ru,api
DJANGO_CSRF_TRUSTED_ORIGINS=https://lms.company.ru
DJANGO_SECURE_COOKIES=true
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=true
DJANGO_SECURE_HSTS_PRELOAD=false
SCORM_CONTENT_ORIGIN=https://scorm.company.ru

POSTGRES_DB=smartis_lms
POSTGRES_USER=smartis
POSTGRES_PASSWORD=replace-with-a-strong-unique-database-password

BOOTSTRAP_DEMO=false
INITIAL_ADMIN_EMAIL=admin@company.ru
INITIAL_ADMIN_PASSWORD=replace-with-a-strong-temporary-password
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=120

MAX_VIDEO_UPLOAD_SIZE=524288000
MAX_COVER_UPLOAD_SIZE=10485760
MAX_HR_DOCUMENT_UPLOAD_SIZE=20971520
MAX_SCORM_UPLOAD_SIZE=1073741824
MAX_SCORM_UNPACKED_SIZE=2147483648
MAX_SCORM_FILES=10000

BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=14
